{
  "name": "@test-platform/server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format cjs --clean",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist node_modules",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@test-platform/shared": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "bcrypt": "^6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.10.1",
    "@types/supertest": "^2.0.12",
    "rimraf": "^6.0.1",
    "supertest": "^6.3.3",
    "tsup": "8.5.1",
    "tsx": "^4.19.1",
    "typescript": "~5.9.3",
    "vitest": "^1.0.0"
  }
}
